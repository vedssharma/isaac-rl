# Copy to .env (git-ignored) and fill in. Never commit the real file.
# Check it with: python scripts/check_env.py

# --- Daytona (GPU sandboxes) ---------------------------------------------
# Dashboard -> Keys -> Create Key. Needs sandbox + snapshot permissions.
DAYTONA_API_KEY=
# Leave as is unless Daytona tells you otherwise.
DAYTONA_API_URL=https://app.daytona.io/api
# Optional default region for sandboxes and snapshots (e.g. us, eu).
# DAYTONA_TARGET=us

# --- Weights & Biases (metrics + checkpoint artifacts) ----------------------
# https://wandb.ai/authorize
WANDB_API_KEY=
# Your W&B username or team name.
WANDB_ENTITY=
WANDB_PROJECT=isaac-rl

# --- Hugging Face Hub (model repo for checkpoints / videos) -----------------
# https://huggingface.co/settings/tokens  (fine-grained, write access to the repo below)
HF_TOKEN=
# e.g. <your-hf-username>/isaac-rl-drone-nav
HF_REPO_ID=

# Private HF repo holding the Isaac Sim wheels (filled by the
# "Mirror Isaac Sim wheels" GitHub Action). Needed on Daytona Tier 1/2.
ISAACSIM_WHEELS_REPO=
